# Copy to backend/.env and fill in. Never commit .env.
# AI investigator / assistant / guidebots (OpenAI-compatible). Unset = deterministic demo fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Razorpay webhook HMAC secret. Unset = events ingested but flagged unverified.
RAZORPAY_WEBHOOK_SECRET=
# Live Razorpay API. Unset = dry-run (simulated refunds, recorded). Set RAZORPAY_LIVE=1 only with real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_LIVE=
# Optional API-key guard for mutating endpoints (header X-API-Key). Unset = open demo mode.
FINOS_API_KEY=
# Optional CORS origins, comma-separated. Default: * (same-origin Vercel deploy is fine).
FINOS_CORS_ORIGINS=
# Optional rate limits (per IP, per minute).
FINOS_RL_WRITE_PER_MIN=60
FINOS_RL_CHAT_PER_MIN=30
# SQLite path. Serverless (Vercel): set to /tmp/finos.db.
FINOS_DB=
